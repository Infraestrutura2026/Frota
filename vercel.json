{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/manutencoes/[id].js": {
      "maxDuration": 60
    },
    "api/manutencao/[id].js": {
      "maxDuration": 60
    },
    "api/vehicles/[id].js": {
      "maxDuration": 60
    },
    "api/users/[id].js": {
      "maxDuration": 60
    },
    "api/trocas-oleo/[id].js": {
      "maxDuration": 60
    },
    "api/oil-changes/[id].js": {
      "maxDuration": 60
    },
    "api/trocas-oleo/relatorio-mensal.js": {
      "maxDuration": 60
    },
    "api/oil-changes/relatorio-mensal.js": {
      "maxDuration": 60
    },
    "api/relatorio-mensal.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
